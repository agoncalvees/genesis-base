{
	"name": "genesis-base",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:local": "NITRO_PRESET=node-server vite build",
		"serve": "node .output/server/index.mjs",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:prod": "bun run build:local && GENESIS_E2E_PROD=1 playwright test --project=production",
		"design:lint": "bun tools/design-engine/cli.ts lint",
		"design:build": "bun tools/design-engine/cli.ts build",
		"design:check": "bun tools/design-engine/cli.ts check",
		"design:diff": "bun tools/design-engine/cli.ts diff",
		"design:import": "bun tools/design-engine/cli.ts import",
		"design:apply": "bun tools/design-engine/cli.ts apply",
		"design:verify": "bun tools/design-engine/verify.ts",
		"new": "bun scripts/new/index.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@openrouter/ai-sdk-provider": "3.1.0",
		"@phosphor-icons/react": "2.1.10",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.7",
		"ai": "7.0.181",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"motion": "14.14.0",
		"nitro": "3.0.260610-beta",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwind-merge": "3.7.1",
		"tailwindcss": "4.3.5",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.1",
		"@biomejs/biome": "2.6.9",
		"@google/design.md": "0.4.0",
		"@playwright/test": "1.65.1",
		"@tailwindcss/vite": "4.3.5",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.13",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"jsdom": "31.0.1",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	}
}
