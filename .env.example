# Módulo ai (opcional). Server only. Never prefix secrets with VITE_.
OPENROUTER_API_KEY=
AI_MODEL_PRIMARY=
AI_MODEL_FALLBACK=
# Request timeout in ms (default 15000, max 120000). Free models often need ~60000.
AI_TIMEOUT_MS=
# AI server functions are OFF unless AI_ENDPOINTS_ENABLED=1.
# Fora do servidor de desenvolvimento Vite, o cabeçalho x-genesis-ai-token deve corresponder a AI_ACCESS_TOKEN.
AI_ENDPOINTS_ENABLED=
AI_ACCESS_TOKEN=
# Opt-in real provider test (spends credits): GENESIS_REAL_AI=1 bun run test
# Optional independent provider variables added only when selected.
